# Copy to .env before running `docker compose up` to override the
# defaults baked into docker-compose.yml.

# AZURE MIGRATION NOTE: JWT_SECRET / DEMO_USERNAME / DEMO_PASSWORD used to
# be here — they're gone. Auth is now real Microsoft Entra ID bearer
# tokens (see Common/Auth/EntraIdAuthExtensions.cs), not a shared local
# secret. The only auth-related value you now need is below.

# Required for the MCP server's Login tool (Entra ID client-credentials
# flow — see Services/McpServer/Tools/AuthTools.cs). Get this from your
# Entra ID app registration's "Certificates & secrets" blade. Never commit
# a real value here — this file is the template, not your actual .env.
AZURE_AD_CLIENT_SECRET=

# Shared secret the containerized MCP server's HTTP endpoint requires from
# any client calling it (Authorization: Bearer <this value>) — see
# Services/McpServer/Program.cs and this project's README for why this
# exists alongside, not instead of, AZURE_AD_CLIENT_SECRET above. Only
# needed if you're running the mcp-server container (docker-compose.yml);
# the stdio path (local `dotnet run`, Claude Desktop launching it directly)
# ignores this entirely. Generate a real random value — e.g.
# `openssl rand -hex 32` — never commit one.
MCP_API_KEY=

SQL_SA_PASSWORD=YourStrong!Passw0rd

# Needed for the Claude document-extraction feature (Origination service).
ANTHROPIC_API_KEY=

# Where the "loan approved" etc. review emails should go. Left blank by
# default in docker-compose.yml — emails just log a warning and are
# skipped if this isn't set, same graceful-degradation behavior
# documented in the main README.
REVIEW_EMAIL=

# host.docker.internal lets containers reach a mail relay running on your
# actual host machine (e.g. the local aiosmtpd test server used to verify
# this feature — see the main README's "Email notifications" section).
# Point this at a real SMTP relay for anything beyond local testing.
SMTP_HOST=host.docker.internal
SMTP_PORT=2525
