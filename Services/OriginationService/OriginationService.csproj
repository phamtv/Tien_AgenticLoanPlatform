<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Set to true (e.g. `dotnet build -p:UseSqlServer=true`, or via
         the docker-compose.yml build arg) to compile in the EF Core /
         SQL Server code path. Defaults to false so this project stays
         buildable with zero external NuGet packages, matching every
         other service in this repo — the in-memory repositories remain
         the verified-working default. -->
    <UseSqlServer Condition="'$(UseSqlServer)' == ''">false</UseSqlServer>
    <DefineConstants Condition="'$(UseSqlServer)' == 'true'">$(DefineConstants);USE_SQL_SERVER</DefineConstants>
    <!-- Per-application trace logging (Common/Logging/TraceLogger.cs).
         Defaults to true so it's on out of the box while this is being
         debugged. Set to false for a production build (e.g.
         `dotnet build -p:TraceLogging=false`, or the TRACE_LOGGING
         docker-compose build arg) to strip every trace call site at
         compile time — see TraceLogger.cs for why this is a true
         compile-time off-switch, not just a log-level filter. -->
    <TraceLogging Condition="'$(TraceLogging)' == ''">true</TraceLogging>
    <DefineConstants Condition="'$(TraceLogging)' == 'true'">$(DefineConstants);TRACE_LOGGING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\LoanPlatform.Contracts.csproj" />
    <ProjectReference Include="..\..\Common\LoanPlatform.Common.csproj" />
  </ItemGroup>

  <!-- Deliberate exception to this repo's "zero external NuGet packages
       by default" convention: unlike the old hand-rolled JwtService
       (a flagged stand-in, never meant to be production-grade), real
       Entra ID token validation involves JWKS fetching, key rollover,
       and RS256 signature verification — exactly the kind of
       security-sensitive code worth using Microsoft's own maintained
       library for rather than hand-rolling. See Common/Auth/EntraIdAuthExtensions.cs. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- EF Core / SQL Server support — only compiled and only restored
       when explicitly opted into. Not compiled or restored in the
       sandbox this project was built in (no NuGet access there); this
       has not been built with UseSqlServer=true anywhere yet. -->
  <ItemGroup Condition="'$(UseSqlServer)' == 'true'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseSqlServer)' != 'true'">
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="Repositories\SqlRepositories.cs" />
  </ItemGroup>

</Project>
