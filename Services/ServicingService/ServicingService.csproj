<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseSqlServer Condition="'$(UseSqlServer)' == ''">false</UseSqlServer>
    <DefineConstants Condition="'$(UseSqlServer)' == 'true'">$(DefineConstants);USE_SQL_SERVER</DefineConstants>
    <!-- Per-application trace logging (Common/Logging/TraceLogger.cs).
         Defaults to true so it's on out of the box while this is being
         debugged. Set to false for a production build (e.g.
         `dotnet build -p:TraceLogging=false`, or the TRACE_LOGGING
         docker-compose build arg) to strip every trace call site at
         compile time — see TraceLogger.cs for why this is a true
         compile-time off-switch, not just a log-level filter. -->
    <TraceLogging Condition="'$(TraceLogging)' == ''">true</TraceLogging>
    <DefineConstants Condition="'$(TraceLogging)' == 'true'">$(DefineConstants);TRACE_LOGGING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\LoanPlatform.Contracts.csproj" />
    <ProjectReference Include="..\..\Common\LoanPlatform.Common.csproj" />
  </ItemGroup>

  <!-- See OriginationService.csproj for why this is the one deliberate
       exception to "zero external NuGet packages by default" here. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSqlServer)' == 'true'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseSqlServer)' != 'true'">
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="Repositories\SqlLoanRepository.cs" />
  </ItemGroup>

</Project>
